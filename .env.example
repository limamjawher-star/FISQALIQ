# ==============================================================================
# FISCALIQ — Configuration des Variables d'Environnement (.env.example)
# ==============================================================================
# RÈGLE DE SÉCURITÉ CRITIQUE :
# 1. Ne commitez JAMAIS de vraies clés API, mots de passe de base de données ou
#    secrets cryptographiques dans Git (.env, .env.local, .env.production sont
#    exclus par .gitignore).
# 2. Toute variable préfixée par `NEXT_PUBLIC_` est exposée au navigateur client.
#    Ne préfixez JAMAIS `GEMINI_API_KEY`, `SUPABASE_SERVICE_ROLE_KEY` ou
#    `FISCALIQ_REPORT_SIGNING_SECRET` par `NEXT_PUBLIC_`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABLES PUBLIQUES (Exposées au navigateur client — `NEXT_PUBLIC_*`)
# ------------------------------------------------------------------------------

# Environnement d'exécution affiché à titre informatif ('development' | 'preview' | 'production')
NEXT_PUBLIC_APP_ENV="development"

# URL publique de votre projet Supabase (Auth & Client RLS uniquement)
# - Development : https://<dev-project-ref>.supabase.co (ou http://127.0.0.1:54321 avec Supabase CLI)
# - Preview     : https://<staging-project-ref>.supabase.co
# - Production  : https://<prod-project-ref>.supabase.co (Région UE recommandée : eu-west-1 ou eu-central-1)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Clé publique anonyme Supabase (`anon` key)
# Sécurisée uniquement lorsque toutes les tables personnelles ont Row-Level Security (RLS) activé
# et que `REVOKE ALL ON ALL TABLES IN SCHEMA public FROM anon;` est appliqué.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# ------------------------------------------------------------------------------
# 2. VARIABLES STRICTEMENT SERVEUR (Secrets — JAMAIS exposées au navigateur)
# ------------------------------------------------------------------------------

# Clé API Google Gemini utilisée EXCLUSIVEMENT dans les routes serveur Node.js :
# - /app/api/tax-assistant/route.ts
# - /app/api/ai/assistant/route.ts
# - /app/api/ai/knowledge-base/route.ts
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Secret cryptographique HMAC-SHA256 (32+ octets aléatoires) utilisé côté serveur
# pour signer et vérifier les liens de téléchargement PDF temporaires (TTL 15 min).
# Générer avec : `openssl rand -base64 32`
FISCALIQ_REPORT_SIGNING_SECRET="replace-with-32-byte-random-hmac-secret-in-production"

# Clé d'administration Supabase (`service_role` key — contourne le RLS)
# À n'utiliser QUE côté serveur pour les tâches d'administration ou la génération d'URL signées Storage.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-server-only"

# Nom du compartiment privé Supabase Storage pour les rapports fiscaux PDF (`public = false`)
SUPABASE_STORAGE_BUCKET="fiscaliq-personal-reports"

# URL canonique de l'application (utilisée pour les métadonnées OpenGraph et vérifications d'origine)
# - Development : http://localhost:3000
# - Preview     : https://<branch-preview>.vercel.app
# - Production  : https://app.fiscaliq.fr (votre domaine personnalisé)
APP_URL="http://localhost:3000"
