# ==============================================================================
# FISCALIQ — Configuration des Variables d'Environnement (.env.example)
# ==============================================================================
# RÈGLE DE SÉCURITÉ CRITIQUE :
# 1. Ne commitez JAMAIS de vraies clés API, mots de passe de base de données ou
#    secrets cryptographiques dans Git (.env, .env.local, .env.production sont
#    exclus par .gitignore).
# 2. Toute variable préfixée par `NEXT_PUBLIC_` est exposée au navigateur client.
#    Ne préfixez JAMAIS `GEMINI_API_KEY`, `SUPABASE_SERVICE_ROLE_KEY`,
#    `FISCALIQ_REPORT_SIGNING_SECRET`, `FISCALIQ_ADMIN_SESSION_TOKEN`,
#    `STRIPE_SECRET_KEY`, `STRIPE_WEBHOOK_SECRET` ou
#    `FISCALIQ_PAYMENT_WEBHOOK_SECRET` par `NEXT_PUBLIC_`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABLES PUBLIQUES (Exposées au navigateur client — `NEXT_PUBLIC_*`)
# ------------------------------------------------------------------------------

# Environnement d'exécution affiché à titre informatif ('development' | 'preview' | 'production')
NEXT_PUBLIC_APP_ENV="development"

# URL publique de votre projet Supabase (Auth & Client RLS uniquement)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Clé publique anonyme Supabase (`anon` key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# ------------------------------------------------------------------------------
# 2. VARIABLES STRICTEMENT SERVEUR (Secrets — JAMAIS exposées au navigateur)
# ------------------------------------------------------------------------------

# Clé API Google Gemini utilisée EXCLUSIVEMENT dans les routes serveur Node.js :
# - /app/api/ai/assistant/route.ts
# - /app/api/ai/knowledge-base/route.ts
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Secret cryptographique HMAC-SHA256 (32+ caractères obligatoires en production)
# utilisé côté serveur pour signer et vérifier les jetons de session et les liens PDF (TTL 15 min).
# Le serveur lève une erreur fatale au démarrage en production si ce secret est absent.
# Générer avec : `openssl rand -base64 32`
FISCALIQ_REPORT_SIGNING_SECRET="replace-with-32-byte-random-hmac-secret-in-production"

# Jeton secret d'administration serveur (32+ caractères) requis pour autoriser les mutations
# POST sur /api/ai/knowledge-base (refus 403 par défaut en l'absence de session admin vérifiée).
FISCALIQ_ADMIN_SESSION_TOKEN="replace-with-32-byte-admin-session-token-in-production"

# Clés Stripe (Paiement abonnement Premium 5 €/mois, Portail Client & Webhook signé)
STRIPE_SECRET_KEY="replace-with-stripe-secret-key-sk_live_or_sk_test"
STRIPE_PREMIUM_PRICE_ID="replace-with-stripe-price-id-5-eur-monthly"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-signing-secret-whsec"

# Secret HMAC-SHA256 alternatif pour vérifier la signature (`x-payment-webhook-signature`)
FISCALIQ_PAYMENT_WEBHOOK_SECRET="replace-with-32-byte-payment-webhook-secret-in-production"

# Activer la redirection obligatoire vers /login sur les routes applicatives ('true' | 'false')
FISCALIQ_REQUIRE_AUTH="false"

# Magasin partagé distribué Upstash Redis (REST) pour les compteurs de limitation
# de débit (rate limits) et l'état des abonnements entre instances serverless.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token-server-only"

# Clé d'administration Supabase (`service_role` key — contourne le RLS)
# Utilisée côté serveur pour le magasin partagé PostgreSQL ou Supabase Storage privé.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-server-only"

# Nom du compartiment privé Supabase Storage pour les rapports fiscaux PDF (`public = false`)
SUPABASE_STORAGE_BUCKET="fiscaliq-personal-reports"

# URL canonique de l'application (utilisée pour les métadonnées OpenGraph et vérifications d'origine CSRF)
APP_URL="http://localhost:3000"
